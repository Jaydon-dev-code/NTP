<Window
    x:Class="SL.ScanData.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SL.ScanData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="湖北双林轴承扫码录入系统"
    Width="800"
    Height="450"
    Activated="Window_Activated"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseDown="Window_PreviewMouseDown"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!--  扫码输入区：失去焦点时边框变红  -->
        <Border
            x:Name="ScanBorder"
            Grid.Row="0"
            Margin="10"
            Padding="8"
            Background="#FFF8F8F8"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    x:Name="FocusHintText"
                    Margin="2,0,0,6"
                    FontWeight="Bold"
                    Foreground="Red"
                    Text="⚠ 扫码输入框未获取焦点，请点击扫码框激活后再扫码！"
                    Visibility="Collapsed" />
                <WrapPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="SN：" />
                    <TextBox
                        x:Name="ScanTextBox"
                        Height="48"
                        Padding="6,4"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="24"
                        FontWeight="Bold"
                        GotKeyboardFocus="ScanTextBox_GotKeyboardFocus"
                        LostKeyboardFocus="ScanTextBox_LostKeyboardFocus"
                        PreviewKeyDown="ScanTextBox_PreviewKeyDown" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  列表标题  -->
        <WrapPanel Grid.Row="1">
            <TextBlock
                Margin="12,4"
                FontSize="14"
                FontWeight="SemiBold"
                Text="最近扫码记录（显示 20 条）" />
            <TextBlock
                Margin="12,4"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="Red"
                Text="扫描时切换为英文输入法" />
        </WrapPanel>


        <!--  扫码记录列表  -->
        <ListView
            Grid.Row="2"
            Margin="10"
            ItemsSource="{Binding Records}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="70" Header="序号">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource TextBlockTitleBold}" Text="{Binding DisplayIndex}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="500" Header="SN 码">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource TextBlockTitleBold}" Text="{Binding Sn}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="220" Header="扫码时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource TextBlockTitleBold}" Text="{Binding ScanTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel
            Grid.Row="3"
            FlowDirection="RightToLeft"
            Orientation="Horizontal">
            <TextBlock x:Name="VersionInfoTextBlock" Margin="10,0" />
            <TextBlock x:Name="TimeTextBlock" />

        </StackPanel>
    </Grid>
</Window>
