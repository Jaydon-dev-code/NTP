<Window x:Class="SL.DataCollectionModuelScript.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SL.DataCollectionModuelScript"
        mc:Ignorable="d"
        Title="设备IP配置工具" Height="560" Width="1100"
        MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- 成功行：浅绿背景 -->
        <Style x:Key="GreenRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#C6EFCE"/>
        </Style>
        <!-- 普通行：白底 -->
        <Style x:Key="WhiteRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
        </Style>
        <!-- 日志颜色 -->
        <SolidColorBrush x:Key="LogOk" Color="Green"/>
        <SolidColorBrush x:Key="LogErr" Color="Red"/>
        <SolidColorBrush x:Key="LogRun" Color="Black"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：搜索 + 设备列表 ========== -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="搜索（设备编号/生产线）：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSearch" Width="200" Height="26" VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>
                <ComboBox x:Name="CboModule" Width="140" Height="26" Margin="12,0,0,0"
                          VerticalContentAlignment="Center" ToolTip="执行时使用的模块型号"/>
                <CheckBox x:Name="ChkObserve" Content="观察页面" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="勾选后浏览器窗口可见，便于观察自动化过程；不勾选则后台无头运行"
                          Checked="ChkObserve_Changed" Unchecked="ChkObserve_Changed"/>
                <Button x:Name="BtnReload" Content="重新加载" Width="80" Height="26" Margin="12,0,0,0"
                        Click="BtnReload_Click"/>
            </StackPanel>

            <!-- 设备列表 -->
            <DataGrid x:Name="Dgv" Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F5F5F5"
                      MouseDoubleClick="Dgv_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackground}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceId}" Width="*"/>
                    <DataGridTextColumn Header="生产线号" Binding="{Binding Line}" Width="*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="*"/>
                    <DataGridTextColumn Header="模块" Binding="{Binding ModuleType}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                    <!-- 行内两个按钮 -->
                    <DataGridTemplateColumn Header="操作" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="配置IP" Width="80" Margin="0,0,8,0"
                                            IsEnabled="{Binding CanClick}"
                                            Click="BtnConfigure_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="还原默认IP" Width="90"
                                            IsEnabled="{Binding CanClick}"
                                            Click="BtnRestore_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 竖直分隔线 -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="#DDD"/>

        <!-- ========== 右侧：状态日志 ========== -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="状态日志" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>

            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="White">
                <RichTextBox x:Name="RtbLog" IsReadOnly="True" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</Window>
