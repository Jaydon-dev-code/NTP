<Window
    x:Class="SL.DataCollectionModuelScript.ConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="二次确认"
    Width="420"
    Height="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            x:Name="TxtTitle"
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="14"
            FontWeight="Bold"
            TextWrapping="Wrap" />

        <!--  设备信息  -->
        <TextBlock
            x:Name="TxtInfo"
            Grid.Row="1"
            Margin="0,0,0,12"
            LineHeight="20"
            TextWrapping="Wrap" />

        <!--  模块选择  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="模块型号：" />
            <ComboBox
                x:Name="CboModule"
                Width="200"
                Height="26"
                VerticalContentAlignment="Center" />
        </StackPanel>

        <!--  模块默认参数说明  -->
        <TextBlock
            x:Name="TxtDefault"
            Grid.Row="3"
            Margin="0,0,0,8"
            Foreground="DarkSlateGray"
            TextWrapping="Wrap" />

        <!--  按钮  -->
        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnOk"
                Width="90"
                Height="28"
                Margin="0,0,10,0"
                Click="BtnOk_Click"
                Content="确认执行" />
            <Button
                Width="70"
                Height="28"
                Content="取消"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
