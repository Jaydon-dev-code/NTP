<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- <add name="DefaultConnection" connectionString="DataSource=SL.MLineDataCollction.sqlite" />-->
    <add name="DefaultConnection" connectionString="PORT=5432;DATABASE=SL.MLineDataCollction;HOST=127.0.0.1;PASSWORD=123;USER ID=postgres" />
  </connectionStrings>
  <appSettings>
	  <add key="IsCreateTable" value="true" />
	  <add key="DbType" value="" />
	  <add key="ServiceUri" value="http://localhost:59088" />
	  <add key="MesPushUri" value="http://localhost:59088" />
	  <add key="ThirdPartyConnection" value="server=10.210.192.185;uid=spc;pwd=123456;database=HubUnitAssemblyLineBusiness;Encrypt=True;TrustServerCertificate=True;" />
	  <add key="ThirdPartyDbType" value="SqlServer" />
	  <add key="MesPushIntervalSeconds" value="10" />
	  <add key="Factory4_10ScanPort" value="9004" />
	  <add key="MqttHeartbeat" value="ip=127.0.0.1;port=1883;user=BearingBranch6;pwd=BearingBranch6;topicId=61"/>
	  <!-- 三方测量库（SQL Server）连接，未配置时 MES 测量数据推送服务显示初始化失败 -->
	  <add key="ThirdPartyConnection" value="server=10.210.192.185;uid=spc;pwd=123456;database=HubUnitAssemblyLineBusiness;Encrypt=True;TrustServerCertificate=True;" />
	  <add key="ThirdPartyDbType" value="SqlServer" />
	  <!-- 型号专用库（产品型号_当前产品型号表/产品型号表）连接，未配置时型号校验服务初始化失败 -->
	  <add key="ModelDbConnection" value="server=10.210.192.185;uid=spc;pwd=123456;database=HubUnitAssemblyLineParameter;Encrypt=True;TrustServerCertificate=True;" />
	  <add key="ModelDbType" value="SqlServer" />
	  <!-- MES 推送地址与路径 -->
	  <add key="MesPushUri" value="http://10.100.22.56:8888" />
	  <add key="MesPushIntervalSeconds" value="10" />
	  <!-- 6分厂2号线型号校验轮询间隔（秒） -->
	  <add key="ModelCheckIntervalSeconds" value="10" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
