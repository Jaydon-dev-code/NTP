<UserControl
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Factory6Workshop6_1AssemblyLine"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="http://schemas.superdev.ch/valueconverters/2016/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SL.MLineDataPrecisionTracking.Client.View.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:usconverters="clr-namespace:SL.MLineDataPrecisionTracking.Client.Common"
    xmlns:usmodels="clr-namespace:SL.MLineDataPrecisionTracking.Models.Enum;assembly=SL.MLineDataPrecisionTracking.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolInverter x:Key="BoolInverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <usconverters:EnumToStringtConverter x:Key="EnumToStringtConverter" />
            <converters:ValueConverterGroup x:Key="InverterBoolToVisibilityConverter">
                <converters:BoolInverter />
                <converters:BoolToVisibilityConverter />
            </converters:ValueConverterGroup>

            <ObjectDataProvider
                x:Key="ResultEnum"
                MethodName="GetNames"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="usmodels:ResultEnum" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="起始时间" />
            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryConditions.StartDate, Mode=TwoWay}" />
                <hc:TimePicker
                    Grid.Column="1"
                    SelectedTime="{Binding QueryConditions.StartTime, Mode=TwoWay}"
                    Style="{StaticResource TimePickerPlus}">
                    <hc:TimePicker.Clock>
                        <hc:ListClock />
                    </hc:TimePicker.Clock>
                </hc:TimePicker>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="结束时间" />
            <Grid
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryConditions.EndDate, Mode=TwoWay}" />
                <hc:TimePicker
                    Grid.Column="1"
                    SelectedTime="{Binding QueryConditions.EndTime, Mode=TwoWay}"
                    Style="{StaticResource TimePickerPlus}">
                    <hc:TimePicker.Clock>
                        <hc:ListClock />
                    </hc:TimePicker.Clock>
                </hc:TimePicker>
            </Grid>

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Text="A 托盘编号" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Width="150"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                Text="{Binding QueryConditions.TrayNoA, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="4"
                Grid.Column="2"
                Text="B 托盘编号" />
            <TextBox
                Grid.Row="4"
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Width="150"
                Height="32"
                Margin="0,0,116,0"
                VerticalAlignment="Top"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                Text="{Binding QueryConditions.TrayNoB, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Text="A NG编号" />
            <TextBox
                Grid.Row="6"
                Grid.Column="1"
                Width="150"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                Text="{Binding QueryConditions.NgCodeA, Mode=TwoWay}" />
            <TextBlock
                Grid.Row="6"
                Grid.Column="2"
                Text="B NG编号" />
            <TextBox
                Grid.Row="6"
                Grid.Column="3"
                Width="150"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                Text="{Binding QueryConditions.NgCodeB, Mode=TwoWay}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="4"
                Text="型号名称" />
            <TextBox
                Grid.Row="2"
                Grid.Column="5"
                Width="150"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                Text="{Binding QueryConditions.ModelName, Mode=TwoWay}" />

            <TextBlock
                Grid.Row="6"
                Grid.Column="4"
                Text="检测结果" />
            <ComboBox
                Grid.Row="6"
                Grid.Column="5"
                Width="150"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}"
                ItemsSource="{Binding Source={StaticResource ResultEnum}}"
                SelectedIndex="0"
                SelectedValue="{Binding QueryConditions.Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                Text="序列码" />
            <TextBox
                Name="MarkingNo"
                Grid.Row="8"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                hc:InfoElement.Necessary="True"
                hc:TitleElement.Title="The title is on the left"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="120"
                Text="{Binding QueryConditions.MarkingNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding
                        Key="Enter"
                        Command="{Binding MarkingNoQueryCommand}"
                        CommandParameter="{Binding ElementName=MarkingNo}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button
                Grid.Row="0"
                Grid.Column="4"
                Command="{Binding QueryCommand}"
                Content="查询"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}" />
            <Button
                Grid.Row="0"
                Grid.Column="5"
                Command="{Binding SaveQueryValueCommand}"
                Content="导出"
                IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}" />

            <CheckBox
                Name="IsScanCode"
                Grid.Row="8"
                Grid.Column="6"
                Width="150"
                hc:Poptip.Content="①扫描数据不对：请将输入切换为英文。 ②扫描没有数据：请将鼠标点击到序列码内。"
                Command="{Binding OpenScanCodeModelCommand}"
                CommandParameter="{Binding ElementName=MarkingNo}"
                Content="扫码查询"
                IsChecked="{Binding QueryConditions.IsScanCode, Mode=TwoWay}" />
        </Grid>
        <hc:TransitioningContentControl Grid.Row="1" Margin="0,5">
            <hc:DrawerContainer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DataGrid
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        hc:DataGridAttach.ShowRowNumber="True"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        ItemsSource="{Binding QueryValue}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Visible"
                        ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHave}" Value="False">
                                        <Setter Property="Background" Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                MinWidth="200"
                                Binding="{Binding RecordTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                Header="时间"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding ModelName}"
                                Header="型号名称"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="90"
                                Binding="{Binding ModelNo}"
                                Header="型号编号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="150"
                                Binding="{Binding MarkingNo}"
                                Header="序列号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="60"
                                Binding="{Binding Result, Converter={StaticResource EnumToStringtConverter}}"
                                Header="检测结果"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding LineATrayNo}"
                                Header="A线托盘编号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding TrayNoB}"
                                Header="托盘号B"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding NgCodeA}"
                                Header="NG代码A"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding NgCodeB}"
                                Header="NG代码B"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding ShieldStationA}"
                                Header="屏蔽工位A"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding ShieldStationB}"
                                Header="屏蔽工位B"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding OuterFlangeSemiFinishedCode}"
                                Header="外法兰半成品码"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding InnerFlangeSemiFinishedCode}"
                                Header="内法兰半成品码"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding ASideSteelBallGroupDiff}"
                                Header="A面钢球组差"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding BSideSteelBallGroupDiff}"
                                Header="B面钢球组差"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding BSideSteelBallGreaseVolume}"
                                Header="B面钢球注脂量"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding ASideSteelBallGreaseVolume}"
                                Header="A面钢球注脂量"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding SealRingParallelDiff}"
                                Header="密封圈平行差"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="100"
                                Binding="{Binding IdentificationCode}"
                                Header="识别代码"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding PositiveClearanceValue}"
                                Header="正游隙检测值"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="90"
                                Binding="{Binding DisplacementValue}"
                                Header="位移量"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding NegativeClearanceValue}"
                                Header="负游隙检测值"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding ActualGap}"
                                Header="实测间隙"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding PreRivetingHeight}"
                                Header="铆接前成型高度"
                                IsReadOnly="True" />

                            <DataGridTextColumn
                                MinWidth="130"
                                Binding="{Binding SealRingPressPressure}"
                                Header="密封圈压装压力"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="130"
                                Binding="{Binding SealRingPressDisplacementB}"
                                Header="密封圈压装位移B"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="165"
                                Binding="{Binding MagneticRingParallelSensor1}"
                                Header="磁性圈平行差检测传感器1"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="165"
                                Binding="{Binding MagneticRingParallelSensor2}"
                                Header="磁性圈平行差检测传感器2"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="165"
                                Binding="{Binding MagneticRingParallelSensor3}"
                                Header="磁性圈平行差检测传感器3"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="120"
                                Binding="{Binding MagneticRingParallelAVG}"
                                Header="磁性圈平行差平均值"
                                IsReadOnly="True" />

                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding EndRunoutAxis}"
                                Header="端跳值轴"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding EndRunoutPlane}"
                                Header="端跳值平面"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding EndRunoutHeight}"
                                Header="端跳值高度"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding TQ_1400}"
                                Header="1400 TQ"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding M_HIGH_1400}"
                                Header="1400 M/HIGH"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding P_1600_M1400_ABSSINGLE_MAX}"
                                Header="1600 P/M1400=ABSSINGLE MAX"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding P_1600_M1400_ABSSINGLE_min}"
                                Header="1600 P/M1400=ABSSINGLE min"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding P_1600_M1400_ABSTOTAL}"
                                Header="1600 P/M1400=ABSTOTAL"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding P_1600_M1400_ABSTOOTH}"
                                Header="1600 P/M1400=ABSTOOTH"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding VibrationDetectionResults}"
                                Header="震动检测结果"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding RunoutValue}"
                                Header="跳动检测值"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding Flatness}"
                                Header="扁平度"
                                IsReadOnly="True" />

                            <DataGridTextColumn
                                MinWidth="110"
                                Binding="{Binding GONO_CHECK_1150}"
                                Header="1150 GONO CHECK"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <hc:Drawer
                        Grid.Column="1"
                        Width="160"
                        Margin="1"
                        IsOpen="{Binding ElementName=IsScanCode, Path=IsChecked, Mode=OneWay}"
                        MaskCanClose="False"
                        ShowMask="False"
                        Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="20" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="扫码记录（近100条）" />
                                    <Button
                                        Command="{Binding SaveQueryValueCommand}"
                                        Content="导出"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                </StackPanel>
                                <ListBox
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding HistoryScanMarkingNos}"
                                    Style="{StaticResource InputElementBaseStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Height="24"
                                                Margin="0"
                                                VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    MinWidth="150"
                                                    Margin="2,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding MarkingNo}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHave}" Value="False">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHave}" Value="True">
                                                                    <Setter Property="Foreground" Value="Black" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveHistoryScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="X"
                                                    Style="{StaticResource ButtonDashedWarning.Small}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button
                                    Grid.Row="2"
                                    Command="{Binding ClearHistoryMarkingNoCommand}"
                                    Content="一键清理"
                                    Style="{StaticResource ButtonDashedWarning.Small}" />
                            </Grid>
                        </Border>
                    </hc:Drawer>
                </Grid>
            </hc:DrawerContainer>
        </hc:TransitioningContentControl>

        <WrapPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource InverterBoolToVisibilityConverter}}">
            <hc:Pagination
                Name="Pagination"
                AutoHiding="False"
                DataCountPerPage="{Binding PaginationPages.DataCountPerPage}"
                MaxPageCount="{Binding PaginationPages.MaxPageCount}"
                PageIndex="{Binding PaginationPages.PageIndex, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PageUpdated">
                        <i:InvokeCommandAction Command="{Binding PageUpdatedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </hc:Pagination>

            <TextBlock Margin="5,0,0,0" Text="每页：" />
            <ComboBox
                Margin="5,0"
                ItemsSource="{Binding PageSoure}"
                SelectedItem="{Binding PaginationPages.DataCountPerPage, Mode=TwoWay}" />
            <TextBlock Margin="0,0,5,0" Text="条" />
            <TextBlock Text="{Binding PaginationPages.TotalCount, StringFormat=共：{0}条}" />
        </WrapPanel>
    </Grid>
</UserControl>
