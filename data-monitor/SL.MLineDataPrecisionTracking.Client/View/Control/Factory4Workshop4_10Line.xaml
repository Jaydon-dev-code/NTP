<UserControl
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Factory4Workshop4_10Line"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="http://schemas.superdev.ch/valueconverters/2016/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SL.MLineDataPrecisionTracking.Client.View.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<Style x:Key="LabelSuccess" BasedOn="{StaticResource LabelSuccess}" />-->
            <converters:BoolToStyleConverter
                x:Key="BoolToStyleConverter"
                FalseValue="{StaticResource LabelDanger}"
                TrueValue="{StaticResource LabelSuccess}" />
            <converters:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="离线"
                TrueValue="在线" />
            <Style BasedOn="{StaticResource TextBoxPlus.Small}" TargetType="hc:TextBox">
                <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="120" />
                <Setter Property="hc:InfoElement.MinContentHeight" Value="25" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontSize" Value="18" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl Style="{DynamicResource TabControlSliding}">
            <TabItem Header="工位监控">
                <UniformGrid Columns="4">
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="游隙1工位" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieClearance, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieClearance, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding ClearanceStation1Data.Clearance1Result}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding ClearanceStation1Data.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding ClearanceStation1Data.Clearance1Time, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                    <hc:TextBox hc:InfoElement.Title="正间隙：" Text="{Binding ClearanceStation1Data.PositiveGap}" />
                                    <hc:TextBox hc:InfoElement.Title="下负荷：" Text="{Binding ClearanceStation1Data.LowerLoad}" />
                                    <hc:TextBox hc:InfoElement.Title="上负荷：" Text="{Binding ClearanceStation1Data.UpperLoad}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="游隙2工位" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieClearance, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieClearance, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding ClearanceStation2Data.Clearance2Result}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding ClearanceStation2Data.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding ClearanceStation2Data.Clearance2Time, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                    <hc:TextBox hc:InfoElement.Title="偏移量：" Text="{Binding ClearanceStation2Data.Offset}" />
                                    <hc:TextBox hc:InfoElement.Title="压入前：" Text="{Binding ClearanceStation2Data.BeforePressIn}" />
                                    <hc:TextBox hc:InfoElement.Title="压入后：" Text="{Binding ClearanceStation2Data.AfterPressIn}" />
                                    <hc:TextBox hc:InfoElement.Title="间隙：" Text="{Binding ClearanceStation2Data.Gap}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="铆接" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding RivetingData.RivetingResult}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding RivetingData.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding RivetingData.RivetingTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                    <hc:TextBox hc:InfoElement.Title="高度检测#1：" Text="{Binding RivetingData.RivetingInspection1Height}" />
                                    <hc:TextBox hc:InfoElement.Title="高度检测#2：" Text="{Binding RivetingData.RivetingInspection2Height}" />
                                    <hc:TextBox hc:InfoElement.Title="成型高度：" Text="{Binding RivetingData.RivetingInspectionFormingHeight}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="旋铆检测" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding SpinRivetingData.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding SpinRivetingData.SpinRivetingTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="震动" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource TextBlockSubTitle}"
                                        Text="设备状态" />
                                    <Label Content="{Binding IsOnlieVib, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieVib, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <UniformGrid Grid.Row="1" Columns="2">
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource TextBlockSubTitle}"
                                        Text="扫码枪状态" />
                                    <Label Content="{Binding IsOnlieVibScan, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieVibScan, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="2"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding VibData.VibCrackResult}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding VibData.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding VibData.VibCrackTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="ABS压紧" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieABS, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieABS, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding ABSPressDownData.ABSPressDownResult}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding ABSPressDownData.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding ABSPressDownData.ABSPressDownTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="ABS检测" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieABS, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieABS, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Margin="10,5,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    Spacing="10">
                                    <hc:TextBox hc:InfoElement.Title="检测结果：" Text="{Binding ABSCheckData.ABSCheckResult}" />
                                    <hc:TextBox hc:InfoElement.Title="SN：" Text="{Binding ABSCheckData.SN}" />
                                    <hc:TextBox hc:InfoElement.Title="采集时间：" Text="{Binding ABSCheckData.ABSCheckTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                </UniformGrid>
            </TabItem>
            <TabItem Header="数据查询">
                <Grid Margin="0,5">
                    <Grid.Resources>
                        <converters:BoolInverter x:Key="BoolInverter" />
                        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                        <converters:ValueConverterGroup x:Key="InverterBoolToVisibilityConverter">
                            <converters:BoolInverter />
                            <converters:BoolToVisibilityConverter />
                        </converters:ValueConverterGroup>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="起始时间" />
                        <Grid
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            IsEnabled="{Binding IsScanCode, Converter={StaticResource BoolInverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryStartDate, Mode=TwoWay}" />
                            <hc:TimePicker
                                Grid.Column="1"
                                SelectedTime="{Binding QueryStartTime, Mode=TwoWay}"
                                Style="{StaticResource TimePickerPlus}">
                                <hc:TimePicker.Clock>
                                    <hc:ListClock />
                                </hc:TimePicker.Clock>
                            </hc:TimePicker>
                        </Grid>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="结束时间" />
                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            IsEnabled="{Binding IsScanCode, Converter={StaticResource BoolInverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryEndDate, Mode=TwoWay}" />
                            <hc:TimePicker
                                Grid.Column="1"
                                SelectedTime="{Binding QueryEndTime, Mode=TwoWay}"
                                Style="{StaticResource TimePickerPlus}">
                                <hc:TimePicker.Clock>
                                    <hc:ListClock />
                                </hc:TimePicker.Clock>
                            </hc:TimePicker>
                        </Grid>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="4"
                            Text="序列码" />
                        <TextBox
                            Name="MarkingNo"
                            Grid.Row="0"
                            Grid.Column="5"
                            Width="200"
                            Style="{StaticResource DataGridEditingTextColumnStyle.Small}"
                            Text="{Binding QuerySN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding MarkingNoQueryCommand}"
                                    CommandParameter="{Binding ElementName=MarkingNo}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button
                            Grid.Row="2"
                            Grid.Column="4"
                            Command="{Binding QueryCommand}"
                            Content="查询"
                            IsEnabled="{Binding IsScanCode, Converter={StaticResource BoolInverter}}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="5"
                            Command="{Binding SaveQueryCommand}"
                            Content="导出" />
                        <CheckBox
                            Name="IsScanCode"
                            Grid.Row="2"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding OpenScanCodeModelCommand}"
                            CommandParameter="{Binding ElementName=MarkingNo}"
                            Content="扫码查询"
                            IsChecked="{Binding IsScanCode, Mode=TwoWay}" />
                    </Grid>
                    <hc:TransitioningContentControl Grid.Row="1" Margin="0,5">
                        <hc:DrawerContainer>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DataGrid
                                    Grid.Column="0"
                                    Margin="0,0,15,0"
                                    AutoGenerateColumns="False"
                                    ItemsSource="{Binding QueryValue}"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            MinWidth="150"
                                            Binding="{Binding RecordTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                            Header="时间"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="120"
                                            Binding="{Binding SN}"
                                            Header="序列码"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding Clearance1Result}"
                                            Header="游隙1结果"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding Clearance2Result}"
                                            Header="游隙2结果"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding PositiveGap}"
                                            Header="正间隙"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding LowerLoad}"
                                            Header="下负荷"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding UpperLoad}"
                                            Header="上负荷"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding Offset}"
                                            Header="偏移量"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding BeforePressIn}"
                                            Header="压入前"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding AfterPressIn}"
                                            Header="压入后"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="80"
                                            Binding="{Binding Gap}"
                                            Header="间隙"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding RivetingResult}"
                                            Header="铆接结果"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding RivetingInspection1Height}"
                                            Header="旋铆高度1"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding RivetingInspection2Height}"
                                            Header="旋铆高度2"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding RivetingInspectionFormingHeight}"
                                            Header="成型高度"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding SpinRivetingResult}"
                                            Header="旋铆结果"
                                            IsReadOnly="True" />

                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding VibCrackResult}"
                                            Header="震动结果"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding ABSPressDownResult}"
                                            Header="ABS压紧结果"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            MinWidth="100"
                                            Binding="{Binding ABSCheckResult}"
                                            Header="ABS检测结果"
                                            IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <hc:Drawer
                                    Grid.Column="1"
                                    Width="160"
                                    Margin="1"
                                    IsOpen="{Binding ElementName=IsScanCode, Path=IsChecked, Mode=OneWay}"
                                    MaskCanClose="False"
                                    ShowMask="False"
                                    Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="20" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="扫码记录（近100条）" />
                                            </StackPanel>
                                            <ListBox
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                ItemsSource="{Binding HistoryScanMarkingNos}"
                                                Style="{StaticResource InputElementBaseStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Height="24"
                                                            Margin="0"
                                                            VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                MinWidth="150"
                                                                Margin="2,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding MarkingNo}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHave}" Value="False">
                                                                                <Setter Property="Foreground" Value="Red" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsHave}" Value="True">
                                                                                <Setter Property="Foreground" Value="Black" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="5,0,0,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.RemoveHistoryScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="X"
                                                                Style="{StaticResource ButtonDashedWarning.Small}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button
                                                Grid.Row="2"
                                                Command="{Binding ClearHistoryMarkingNoCommand}"
                                                Content="一键清理"
                                                Style="{StaticResource ButtonDashedWarning.Small}" />
                                        </Grid>
                                    </Border>
                                </hc:Drawer>
                            </Grid>
                        </hc:DrawerContainer>
                    </hc:TransitioningContentControl>
                    <WrapPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource InverterBoolToVisibilityConverter}}">
                        <hc:Pagination
                            Name="Pagination"
                            AutoHiding="False"
                            DataCountPerPage="{Binding PaginationPages.DataCountPerPage}"
                            MaxPageCount="{Binding PaginationPages.MaxPageCount}"
                            PageIndex="{Binding PaginationPages.PageIndex, Mode=TwoWay}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PageUpdated">
                                    <i:InvokeCommandAction Command="{Binding PageUpdatedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </hc:Pagination>
                        <TextBlock Margin="5,0,0,0" Text="每页：" />
                        <ComboBox
                            Margin="5,0"
                            ItemsSource="{Binding PageSoure}"
                            SelectedItem="{Binding PaginationPages.DataCountPerPage, Mode=TwoWay}" />
                        <TextBlock Margin="0,0,5,0" Text="条" />
                        <TextBlock Text="{Binding PaginationPages.TotalCount, StringFormat=共：{0}条}" />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
