<UserControl
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Factory4Workshop4_10Line"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="http://schemas.superdev.ch/valueconverters/2016/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SL.MLineDataPrecisionTracking.Client.View.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<Style x:Key="LabelSuccess" BasedOn="{StaticResource LabelSuccess}" />-->
            <converters:BoolToStyleConverter
                x:Key="BoolToStyleConverter"
                FalseValue="{StaticResource LabelDanger}"
                TrueValue="{StaticResource LabelSuccess}" />
            <converters:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="离线"
                TrueValue="在线" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl Style="{DynamicResource TabControlSliding}">
            <TabItem Header="工位监控">
                <UniformGrid Columns="4">
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="游隙" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieClearance, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieClearance, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <ListBox Grid.Row="1" BorderThickness="0,1,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="25" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="铆接和裂纹检测" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieRivetAndCrack, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <ListBox Grid.Row="1" BorderThickness="0,1,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="25" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </hc:Card>

                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="震动" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieVib, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieVib, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <ListBox Grid.Row="1" BorderThickness="0,1,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="25" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </hc:Card>

                    <hc:Card Margin="5">
                        <GroupBox Style="{StaticResource GroupBoxOriginal}">
                            <GroupBox.Header>
                                <WrapPanel HorizontalAlignment="Left">
                                    <TextBlock
                                        Width="50"
                                        Style="{DynamicResource TextBlockTitle}"
                                        Text="工位:" />
                                    <TextBlock Style="{DynamicResource TextBlockTitle}" Text="ABS" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="2">
                                    <TextBlock Style="{DynamicResource TextBlockSubTitle}" Text="设备状态" />
                                    <Label Content="{Binding IsOnlieABS, Converter={StaticResource BoolToStringConverter}}" Style="{Binding IsOnlieABS, Converter={StaticResource BoolToStyleConverter}}" />
                                </UniformGrid>
                                <ListBox Grid.Row="1" BorderThickness="0,1,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="25" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Data}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Unit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </hc:Card>
                </UniformGrid>
            </TabItem>
            <TabItem Header="数据查询" />
        </TabControl>
    </Grid>
</UserControl>
