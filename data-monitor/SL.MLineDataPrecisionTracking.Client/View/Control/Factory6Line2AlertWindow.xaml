<Window
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Factory6Line2AlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="型号不一致告警"
    Width="440"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="False"
    Background="Transparent"
    AllowsTransparency="True"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    mc:Ignorable="d">
    <!--  无边框置顶窗口：不可缩放/最小化，按住可拖动；非模态 Show() 不影响主窗体操作；
         无按钮（全自动记录），型号恢复一致或无执行中订单时后台推送自动关窗  -->
    <Border
        Margin="8"
        Background="#FDF6EC"
        BorderBrush="#E6A23C"
        BorderThickness="2"
        CornerRadius="6">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题  -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#E6A23C"
                    Text="⚠ " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#303133"
                    Text="型号不一致告警" />
            </StackPanel>

            <!--  提示信息  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,12,0,0"
                FontSize="14"
                Foreground="#303133"
                Text="{Binding AlertMessage}"
                TextWrapping="Wrap" />

            <!--  型号对比  -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,2,10,2"
                    Foreground="#909399"
                    Text="当前生产型号：" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,2"
                    FontWeight="Bold"
                    Foreground="#E6A23C"
                    Text="{Binding ThirdPartyModel}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,2,10,2"
                    Foreground="#909399"
                    Text="执行中订单型号：" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,2"
                    FontWeight="Bold"
                    Foreground="#F56C6C"
                    Text="{Binding OrderModel}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,2,10,2"
                    Foreground="#909399"
                    Text="执行中工单号：" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,2"
                    Text="{Binding WorkOrderNo}" />
            </Grid>

            <!--  关闭提示：自动关窗  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#C0C4CC"
                Text="型号恢复一致或无执行中订单后，本窗口自动关闭" />
        </Grid>
    </Border>
</Window>
