<UserControl
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Rcl_MeticulousPursuit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="http://schemas.superdev.ch/valueconverters/2016/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SL.MLineDataPrecisionTracking.Client.View.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:usconverters="clr-namespace:SL.MLineDataPrecisionTracking.Client.Common"
    xmlns:usmodels="clr-namespace:SL.MLineDataPrecisionTracking.Models.Enum;assembly=SL.MLineDataPrecisionTracking.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolInverter x:Key="BoolInverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <usconverters:EnumToStringtConverter x:Key="EnumToStringtConverter" />
            <usconverters:IntEqualsConverter x:Key="IntEqualsConverter" />
            <converters:ValueConverterGroup x:Key="InverterBoolToVisibilityConverter">
                <converters:BoolInverter />
                <converters:BoolToVisibilityConverter />
            </converters:ValueConverterGroup>

            <ObjectDataProvider
                x:Key="ResultEnum"
                MethodName="GetNames"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="usmodels:ResultEnum" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl Margin="5,0,0,0" Style="{DynamicResource TabControlSliding}">
        <TabItem Header="能量监控">
            <ContentControl Content="{Binding PlotControl, Mode=OneWay}" />
        </TabItem>
        <TabItem Header="数据追溯">
            <Grid Margin="0,5">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="413*" />
                    <ColumnDefinition Width="16*" />
                    <ColumnDefinition Width="369*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="起始时间" />
                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryConditions.StartDate, Mode=TwoWay}" />
                        <hc:TimePicker
                            Grid.Column="1"
                            SelectedTime="{Binding QueryConditions.StartTime, Mode=TwoWay}"
                            Style="{StaticResource TimePickerPlus}">
                            <hc:TimePicker.Clock>
                                <hc:ListClock />
                            </hc:TimePicker.Clock>
                        </hc:TimePicker>
                    </Grid>

                    <!--<hc:DateTimePicker SelectedDateTime="{Binding QueryConditions.StartTime, Mode=TwoWay}" Style="{StaticResource DateTimePickerPlus.Small}" />-->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="结束时间" />
                    <Grid
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <hc:DatePicker Grid.Column="0" SelectedDate="{Binding QueryConditions.EndDate, Mode=TwoWay}" />
                        <hc:TimePicker
                            Grid.Column="1"
                            SelectedTime="{Binding QueryConditions.EndTime, Mode=TwoWay}"
                            Style="{StaticResource TimePickerPlus}">
                            <hc:TimePicker.Clock>
                                <hc:ListClock />
                            </hc:TimePicker.Clock>
                        </hc:TimePicker>
                    </Grid>

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Text="序列码" />
                    <TextBox
                        Name="MarkingNo"
                        Grid.Row="4 "
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        hc:InfoElement.Necessary="True"
                        hc:TitleElement.Title="The title is on the left"
                        hc:TitleElement.TitlePlacement="Left"
                        hc:TitleElement.TitleWidth="120"
                        Text="{Binding QueryConditions.MarkingNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding
                                Key="Enter"
                                Command="{Binding MarkingNoQueryCommand}"
                                CommandParameter="{Binding ElementName=MarkingNo}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button
                        Grid.Row="0"
                        Grid.Column="4"
                        Command="{Binding QueryCommand}"
                        Content="查询"
                        IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="5"
                        Command="{Binding SaveQueryCommand}"
                        Content="导出"
                        IsEnabled="{Binding QueryConditions.IsScanCode, Converter={StaticResource BoolInverter}}" />

                    <CheckBox
                        Name="IsScanCode"
                        Grid.Row="4"
                        Grid.Column="6"
                        Width="150"
                        hc:Poptip.Content="①扫描数据不对：请将输入切换为英文。 ②扫描没有数据：请将鼠标点击到序列码内。"
                        Command="{Binding OpenScanCodeModelCommand}"
                        CommandParameter="{Binding ElementName=MarkingNo}"
                        Content="扫码查询"
                        IsChecked="{Binding QueryConditions.IsScanCode, Mode=TwoWay}" />
                </Grid>
                <hc:TransitioningContentControl
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,5,0,5">
                    <hc:DrawerContainer>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!--  左边：DataGrid 自动占满  -->
                                <ColumnDefinition Width="Auto" />
                                <!--  右边：Drawer 自动撑开/收缩  -->
                            </Grid.ColumnDefinitions>
                            <DataGrid
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                hc:DataGridAttach.ShowRowNumber="True"
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False"
                                CanUserSortColumns="False"
                                ItemsSource="{Binding QueryValue}"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <DataGrid.RowStyle>
                                    <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="DataGridRow">
                                        <!--  绑定模型里的 IsSpecial 字段，为 true 就变色  -->
                                        <Style.Triggers>
                                            <!--  IsHave = false → 灰色  -->
                                            <DataTrigger Binding="{Binding IsHave}" Value="False">
                                                <Setter Property="Background" Value="Red" />
                                            </DataTrigger>

                                            <!--<DataTrigger Binding="{Binding IsHave}" Value="True">
                                     <Setter Property="Background" Value="Transparent" />
                                 </DataTrigger>-->
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        MinWidth="200"
                                        Binding="{Binding RecordTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                        Header="时间"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        MinWidth="160"
                                        Binding="{Binding MarkingNo}"
                                        Header="序列码"
                                        IsReadOnly="True" />
                                    <!--  加热时间  -->
                                    <DataGridTextColumn
                                        MinWidth="100"
                                        Binding="{Binding HeatingTime}"
                                        Header="加热时间（秒）"
                                        IsReadOnly="True" />

                                    <!--  冷却开始时间  -->
                                    <DataGridTextColumn
                                        MinWidth="130"
                                        Binding="{Binding CoolingStartTime}"
                                        Header="冷却开始时间（秒）"
                                        IsReadOnly="True" />

                                    <!--  冷却时间  -->
                                    <DataGridTextColumn
                                        MinWidth="100"
                                        Binding="{Binding CoolingTime}"
                                        Header="冷却时间（秒）"
                                        IsReadOnly="True" />

                                    <!--  输出功率  -->
                                    <DataGridTextColumn
                                        MinWidth="100"
                                        Binding="{Binding OutputPower}"
                                        Header="输出功率（kw）"
                                        IsReadOnly="True" />

                                    <!--  输出电压  -->
                                    <DataGridTextColumn
                                        MinWidth="100"
                                        Binding="{Binding OutputVoltage}"
                                        Header="输出电压（V）"
                                        IsReadOnly="True" />

                                    <!--  输出频率  -->
                                    <DataGridTextColumn
                                        MinWidth="100"
                                        Binding="{Binding OutputFrequency}"
                                        Header="输出频率（kHz）"
                                        IsReadOnly="True" />

                                    <!--  外喷冷却水量  -->
                                    <DataGridTextColumn
                                        MinWidth="120"
                                        Binding="{Binding ExternalSprayCoolingWater}"
                                        Header="外喷冷却水量（L/分）"
                                        IsReadOnly="True" />

                                    <!--  辅喷冷却水量  -->
                                    <DataGridTextColumn
                                        MinWidth="120"
                                        Binding="{Binding AuxiliarySprayCoolingWater}"
                                        Header="辅喷冷却水量（L/分）"
                                        IsReadOnly="True" />

                                    <DataGridTextColumn
                                        MinWidth="120"
                                        Binding="{Binding Energy}"
                                        Header="能量（kJ）"
                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <hc:Drawer
                                Grid.Column="1"
                                Width="160"
                                Margin="1"
                                IsOpen="{Binding ElementName=IsScanCode, Path=IsChecked, Mode=OneWay}"
                                MaskCanClose="False"
                                ShowMask="False"
                                Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="扫码记录（近100条）" />
                                            <Button
                                                Command="{Binding SaveQueryCommand}"
                                                Content="导出"
                                                Style="{StaticResource ButtonInfo.Small}" />
                                        </StackPanel>
                                        <ListBox
                                            Grid.Row="1"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{Binding HistoryScanMarkingNos}"
                                            Style="{StaticResource InputElementBaseStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!--  一行布局：左边文字自动填满，右边固定按钮  -->
                                                    <Grid
                                                        Height="24"
                                                        Margin="0"
                                                        VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <!--  文字占满剩余空间  -->
                                                            <ColumnDefinition Width="Auto" />
                                                            <!--  按钮自适应宽度  -->
                                                        </Grid.ColumnDefinitions>

                                                        <!--  文字：靠左  -->
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            MinWidth="150"
                                                            Margin="2,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding MarkingNo}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <!--  IsHave = false → 灰色  -->
                                                                        <DataTrigger Binding="{Binding IsHave}" Value="False">
                                                                            <Setter Property="Foreground" Value="Red" />
                                                                        </DataTrigger>

                                                                        <!--  IsHave = true → 黑色（默认）  -->
                                                                        <DataTrigger Binding="{Binding IsHave}" Value="True">
                                                                            <Setter Property="Foreground" Value="Black" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!--  按钮：靠右  -->
                                                        <Button
                                                            Grid.Column="1"
                                                            Margin="5,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveHistoryScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="X"
                                                            Style="{StaticResource ButtonDashedWarning.Small}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button
                                            Grid.Row="2"
                                            Command="{Binding ClearHistoryMarkingNoCommand}"
                                            Content="一键清理"
                                            Style="{StaticResource ButtonDashedWarning.Small}" />
                                    </Grid>
                                </Border>
                            </hc:Drawer>
                        </Grid>
                    </hc:DrawerContainer>
                </hc:TransitioningContentControl>

                <WrapPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Margin="301,0,0,0"
                    HorizontalAlignment="Left"
                    Visibility="{Binding ElementName=IsScanCode, Path=IsChecked, Converter={StaticResource InverterBoolToVisibilityConverter}}">
                    <hc:Pagination
                        Name="Pagination"
                        AutoHiding="False"
                        DataCountPerPage="{Binding PaginationPages.DataCountPerPage}"
                        MaxPageCount="{Binding PaginationPages.MaxPageCount}"
                        PageIndex="{Binding PaginationPages.PageIndex, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PageUpdated">
                                <i:InvokeCommandAction Command="{Binding PageUpdatedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </hc:Pagination>

                    <TextBlock Margin="5,0,0,0" Text="每页：" />
                    <ComboBox
                        Margin="5,0"
                        ItemsSource="{Binding PageSoure}"
                        SelectedItem="{Binding PaginationPages.DataCountPerPage, Mode=TwoWay}" />
                    <TextBlock Margin="0,0,5,0" Text="条" />
                    <TextBlock Text="{Binding PaginationPages.TotalCount, StringFormat=共：{0}条}" />
                </WrapPanel>
            </Grid>
        </TabItem>
        <TabItem Header="能量监控查询">
            <Grid Margin="0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="247*" />
                        <ColumnDefinition Width="12*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="259*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="起始时间" />
                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <hc:DatePicker Grid.Column="0" SelectedDate="{Binding EnergyQueryStartDate, Mode=TwoWay}" />
                        <hc:TimePicker
                            Grid.Column="1"
                            SelectedTime="{Binding EnergyQueryStartTime, Mode=TwoWay}"
                            Style="{StaticResource TimePickerPlus}">
                            <hc:TimePicker.Clock>
                                <hc:ListClock />
                            </hc:TimePicker.Clock>
                        </hc:TimePicker>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="结束时间" />
                    <Grid
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <hc:DatePicker Grid.Column="0" SelectedDate="{Binding EnergyQueryEndDate, Mode=TwoWay}" />
                        <hc:TimePicker
                            Grid.Column="1"
                            SelectedTime="{Binding EnergyQueryEndTime, Mode=TwoWay}"
                            Style="{StaticResource TimePickerPlus}">
                            <hc:TimePicker.Clock>
                                <hc:ListClock />
                            </hc:TimePicker.Clock>
                        </hc:TimePicker>

                    </Grid>
                    <Button
                        Grid.Row="2"
                        Grid.Column="4"
                        Command="{Binding EnergyRangeQueryCommand}"
                        Content="查询" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,5,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox
                            Grid.Row="0"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding EnergyRangeItems}"
                            SelectedItem="{Binding SelectedEnergyRange}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="2"
                                        HorizontalAlignment="Center"
                                        Text="{Binding RecordTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel
                            Grid.Row="1"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center">
                            <hc:Pagination
                                AutoHiding="False"
                                DataCountPerPage="{Binding EnergyRangePagination.DataCountPerPage}"
                                MaxPageCount="{Binding EnergyRangePagination.MaxPageCount}"
                                PageIndex="{Binding EnergyRangePagination.PageIndex, Mode=TwoWay}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PageUpdated">
                                        <i:InvokeCommandAction Command="{Binding EnergyRangePageUpdatedCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </hc:Pagination>
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="每页：" />
                            <ComboBox
                                Margin="5,0"
                                ItemsSource="{Binding PageSoure}"
                                SelectedItem="{Binding EnergyRangePagination.DataCountPerPage, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Text="条" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding EnergyRangePagination.TotalCount, StringFormat=共：{0}条}" />
                        </WrapPanel>

                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <ContentControl Grid.Row="0" Content="{Binding EnergyPointPlot, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="能量范围设置">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Left panel: monitor item list + product models  -->
                <Grid Grid.Column="0" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="1"
                        Margin="0,5"
                        Background="Gray" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="产品型号" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding RefreshEnergyRangeCommand}"
                            Content="刷新" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding ImportEnergyRangeCommand}"
                            Content="导入" />
                        <Button
                            Margin="5,0,0,0"
                            Command="{Binding DeleteMonitorItemCommand}"
                            Content="删除" />
                    </StackPanel>

                    <ListBox
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        ItemsSource="{Binding ProductModels}"
                        SelectedItem="{Binding SelectedProductModel}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding ProductModel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IntEqualsConverter}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.CurrentModelNo" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Foreground" Value="Red" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="Red"
                                        Text="当前生产">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IntEqualsConverter}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.CurrentModelNo" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!--  Right panel: chart + time axis configs  -->
                <Grid Grid.Column="1" Margin="5">
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="120*" />
                            <RowDefinition Height="61*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="5,5,5,5"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="当前型号：" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="{Binding CurrentModelName}" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding SetCurrentProductionCommand}"
                                Content="设定为当前生产型号" />
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ExportTemplateCommand}"
                                Content="导出模板" />
                        </StackPanel>

                        <ContentControl
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Content="{Binding SettingPlotControl, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
