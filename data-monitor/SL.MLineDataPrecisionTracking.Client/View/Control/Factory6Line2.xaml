<UserControl
    x:Class="SL.MLineDataPrecisionTracking.Client.View.Control.Factory6Line2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mes="clr-namespace:SL.MLineDataPrecisionTracking.Client.View.Mes"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            VerticalAlignment="Center"
            FontSize="18"
            FontWeight="Bold"
            Text="6分厂2号线" />

        <!--  MES 控件区域  -->
        <Border
            Grid.Row="1"
            Padding="10"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <mes:MesOrderList />
        </Border>
    </Grid>
</UserControl>
