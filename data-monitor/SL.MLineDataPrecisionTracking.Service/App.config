<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="DefaultConnection" connectionString="PORT=5432;DATABASE=SL.MLineDataCollction;HOST=127.0.0.1;PASSWORD=123;USER ID=postgres" />
	</connectionStrings>
	<appSettings>
		<add key="IsCreateTable" value="true" />
		<add key="DbType" value="" />
		<add key="ServiceUri" value="http://*:59088" />
		<add key="Factory4_10ScanPort" value="9004" />
		<add key="Factory4_10_ClearanceScanPort" value="9005" />
		<add key="MqttHeartbeat" value="ip=127.0.0.1;port=1883;user=BearingBranch6;pwd=BearingBranch6;topicId=61"/>
		<!-- 三方/共享库：连接串 + 返回当前型号的 SQL（可连表） -->
		<add key="ThirdPartyDb_Enabled" value="false" />
		<add key="ThirdPartyDb_ConnectionString" value="" />
		<add key="ThirdPartyDb_DbType" value="PostgreSQL" />
		<!-- 例：SELECT m.model_no FROM line_status s JOIN model m ON m.id=s.model_id WHERE s.line_id='L1' -->
		<add key="ThirdPartyDb_CurrentModelSql" value="" />
		<add key="ThirdPartyDb_SyncIntervalSeconds" value="30" />
	</appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
